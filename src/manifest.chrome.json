{
  "manifest_version": 3,
  "name": "Mail Checker for Bulwark",
  "version": "0.2.0",
  "description": "New mail notifications and a quick mail overlay for your Bulwark webmail. Unofficial.",
  "minimum_chrome_version": "120",
  "author": "Lenart Kos",
  "homepage_url": "https://github.com/Lenart12/mail-checker-for-bulwark",
  "icons": { "128": "icon.png" },
  "permissions": ["storage", "notifications", "contextMenus", "alarms", "offscreen", "scripting", "declarativeNetRequestWithHostAccess", "webRequest"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mail Checker for Bulwark", "default_icon": "icon.png" },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
